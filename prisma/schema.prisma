generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum UserRole {
  ADMIN
  SELLER
}

// ──────────────────────────────────────────────
// USER
// ──────────────────────────────────────────────

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      UserRole @default(SELLER)
  isActive  Boolean  @default(true)
  stores    Store[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@index([isActive])
}

// ──────────────────────────────────────────────
// STORE (UMKM)
// ──────────────────────────────────────────────

model Store {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?   @db.Text
  logo        String?
  banner      String?
  address     String?   @db.Text
  phone       String?
  whatsapp    String?
  latitude    Float?
  longitude   Float?
  isActive    Boolean   @default(true)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]
  galleries   Gallery[]
  visitors    Visitor[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([slug])
  @@index([isActive])
  @@index([latitude, longitude])
}

// ──────────────────────────────────────────────
// CATEGORY
// ──────────────────────────────────────────────

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?   @db.Text
  image       String?
  icon        String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isActive])
}

// ──────────────────────────────────────────────
// PRODUCT
// ──────────────────────────────────────────────

model Product {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  slug        String         @unique
  description String?        @db.Text
  price       Decimal        @db.Decimal(12, 2)
  stock       Int            @default(0)
  unit        String         @default("pcs")
  isActive    Boolean        @default(true)
  isFeatured  Boolean        @default(false)
  storeId     String         @db.Uuid
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  String         @db.Uuid
  category    Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      ProductImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([storeId])
  @@index([categoryId])
  @@index([slug])
  @@index([isActive, isFeatured])
  @@index([price])
}

// ──────────────────────────────────────────────
// PRODUCT IMAGE
// ──────────────────────────────────────────────

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  url       String
  alt       String?
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([productId, isPrimary])
}

// ──────────────────────────────────────────────
// GALLERY (Store-level images)
// ──────────────────────────────────────────────

model Gallery {
  id        String   @id @default(uuid()) @db.Uuid
  url       String
  alt       String?
  storeId   String   @db.Uuid
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([storeId])
}

// ──────────────────────────────────────────────
// BANNER (Independent)
// ──────────────────────────────────────────────

model Banner {
  id        String   @id @default(uuid()) @db.Uuid
  title     String?
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ──────────────────────────────────────────────
// WEBSITE SETTING (Singleton — only one row)
// ──────────────────────────────────────────────

model WebsiteSetting {
  id              String   @id @default("singleton")
  siteName        String?
  siteDescription String?  @db.Text
  logo            String?
  favicon         String?
  primaryColor    String?
  contactEmail    String?
  contactPhone    String?
  address         String?  @db.Text
  aboutUs         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ──────────────────────────────────────────────
// VISITOR (Store analytics)
// ──────────────────────────────────────────────

model Visitor {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @db.Uuid
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?  @db.Text
  pageUrl   String?
  referrer  String?  @db.Text
  visitedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([storeId, visitedAt])
  @@index([visitedAt])
}
